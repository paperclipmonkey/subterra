APP_NAME=Subterra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Postgres-only: bound lock-acquire wait (and total statement runtime) so a contended
# lock can't wedge the sequential scheduler loop indefinitely. Migrations are exempt.
# DB_LOCK_TIMEOUT=10s
# DB_STATEMENT_TIMEOUT=30s

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEILISEARCH_NO_ANALYTICS=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

FRONTEND_URL=http://localhost:3000

SLACK_SIGNUPS_WEBHOOK=
SLACK_TRIPS_WEBHOOK=
SLACK_CORRECTIONS_WEBHOOK=
SLACK_CALLOUTS_OPEN_WEBHOOK=
SLACK_CALLOUTS_CLOSED_WEBHOOK=
SLACK_CALLOUTS_OVERDUE_WEBHOOK=
SLACK_CLUB_APPROVAL_WEBHOOK=
SLACK_LOGGING_WEBHOOK_URL=

PIRATE_WEATHER_API_KEY=

# Twilio — primary SMS + voice (Fly/Subterra side). The GCP watchdog uses TextMagic.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Shared secret embedded in the inbound webhook URLs configured in the Twilio console.
TWILIO_WEBHOOK_SECRET=
# Master kill-switch for real outbound SMS/voice (keep false in staging/local).
TWILIO_ENABLED=false

# Callout escalation ladder (minutes) + duty-officer WhatsApp group invite link.
CALLOUT_VOICE_AFTER_MINUTES=3
CALLOUT_VOICE_REPEAT_MINUTES=3
CALLOUT_VOICE_MAX_ATTEMPTS=5
CALLOUT_UNMANAGED_AFTER_MINUTES=15
CALLOUT_WHATSAPP_GROUP_URL=

# Feature flags
# Grant new users callout access by default. Existing users are unaffected and can
# still be toggled individually from the admin users page.
FEATURE_CALLOUT_ACCESS_DEFAULT=true

# GCP Watchdog Service
GCP_WATCHDOG_URL=
GCP_WATCHDOG_API_KEY=
GCP_WATCHDOG_TEST_EMAIL=admin@subterra.world
GCP_WATCHDOG_TEST_PHONE=

# GCP Media Processing (Transcoder API + Cloud Run Image Processor)
GCP_PROJECT_ID=
GCP_LOCATION=europe-west2
GCP_TRANSCODER_PUBSUB_TOPIC=
GCP_WEBHOOK_SECRET=
GCP_IMAGE_PROCESSOR_API_KEY=
GCS_PROJECT_ID=
GCS_KEY_FILE=
GCS_KEY_FILE_JSON=
GCS_TRANSCODER_BUCKET=subterra-media-staging

SAIL_XDEBUG_MODE=develop,debug,coverage

CRON_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/<heartbeat_id>