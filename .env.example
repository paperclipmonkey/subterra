APP_NAME=Subterra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

MEILISEARCH_NO_ANALYTICS=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

FRONTEND_URL=http://localhost:3000

SMS_ENABLED=false

SLACK_SIGNUPS_WEBHOOK=
SLACK_TRIPS_WEBHOOK=
SLACK_CORRECTIONS_WEBHOOK=
SLACK_CALLOUTS_OPEN_WEBHOOK=
SLACK_CALLOUTS_CLOSED_WEBHOOK=
SLACK_CALLOUTS_OVERDUE_WEBHOOK=
SLACK_CLUB_APPROVAL_WEBHOOK=
SLACK_LOGGING_WEBHOOK_URL=

PIRATE_WEATHER_API_KEY=

CLICKSEND_USERNAME=user
CLICKSEND_API_KEY=key
CLICKSEND_WEBHOOK_SECRET=secret

SMS_WORKS_WEBHOOK_SECRET=secret

# GCP Watchdog Service
GCP_WATCHDOG_URL=
GCP_WATCHDOG_API_KEY=
GCP_WATCHDOG_TEST_EMAIL=admin@subterra.world
GCP_WATCHDOG_TEST_PHONE=

# GCP Media Processing (Transcoder API + Cloud Run Image Processor)
GCP_PROJECT_ID=
GCP_LOCATION=europe-west2
GCP_TRANSCODER_PUBSUB_TOPIC=
GCP_WEBHOOK_SECRET=
GCP_IMAGE_PROCESSOR_API_KEY=
GCS_PROJECT_ID=
GCS_KEY_FILE=
GCS_KEY_FILE_JSON=
GCS_TRANSCODER_BUCKET=subterra-media-staging

SAIL_XDEBUG_MODE=develop,debug,coverage

CRON_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/<heartbeat_id>