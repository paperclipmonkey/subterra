# GCP Project Configuration
GCP_PROJECT_ID=your-gcp-project-id

# TextMagic Configuration
TEXTMAGIC_USERNAME=your-textmagic-username
TEXTMAGIC_API_KEY=your-textmagic-api-key

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=watchdog@subterra.world

# Slack Configuration
# General log forwarding (console.warn / console.error -> Slack)
SLACK_WEBHOOK_URL=
# Optional: dedicated webhook for structured overdue-callout alerts (e.g. #callouts-overdue,
# ideally the same channel the primary Subterra app posts to). Falls back to
# SLACK_WEBHOOK_URL when unset.
SLACK_CALLOUTS_WEBHOOK_URL=

# Server Configuration
PORT=8080

# Optional: For local development with Firestore Emulator
# FIRESTORE_EMULATOR_HOST=localhost:8082
