server {
    listen 8080 default_server;
    listen [::]:8080 default_server;

    root /var/www/html/public;

    index index.html index.htm;

    server_name _;

    charset utf-8;

    client_max_body_size 2048M;

    access_log /dev/stdout fly;

    location / {
        try_files $uri $uri/ @octane;
    }

    location @octane {
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $http_fly_client_ip;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffers 16 16k;
        proxy_buffer_size 32k;
        proxy_pass http://127.0.0.1:8000;
    }

    # Pip streams long SSE replies, so it stays on its own php-fpm pool rather
    # than holding an Octane worker (see .fly/fpm/pool.d/assistant.conf).
    location ^~ /api/assistant/ {
        include fastcgi.conf;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_X_FORWARDED_FOR $http_fly_client_ip;
        fastcgi_pass unix:/var/run/php/php-fpm-assistant.sock;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Nothing is executed from public/ directly; never serve PHP source.
    location ~ \.php$ {
        return 404;
    }

    # The SPA shell. "/" is served from here by nginx (never PHP), so it needs its
    # own frame protection, and must be revalidated so a deploy isn't masked by a
    # heuristically cached index.html pointing at hashed assets that are gone.
    location = /index.html {
        include snippets/security-headers.conf;
        add_header X-Frame-Options         "SAMEORIGIN" always;
        add_header Content-Security-Policy "frame-ancestors 'self'" always;
        add_header Cache-Control           "no-cache" always;
    }

    location = /favicon.ico {
        expires 7d;
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=604800";
        log_not_found off;
        access_log    off;
    }

    location = /robots.txt {
        log_not_found off;
        access_log    off;
    }

    # Vite build assets have content-hash filenames — cache aggressively
    location ~* ^/build/ {
        expires 1y;
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # Vite emits content-hashed JS/CSS/assets here (frontend dist/assets) — safe
    # to cache forever and mark immutable so repeat visitors never re-request.
    location ~* ^/assets/ {
        expires 1y;
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    location ~* \.(?:css(\.map)?|js(\.map)?|jpe?g|png|gif|ico|cur|heic|webp|tiff?|mp3|m4a|aac|ogg|midi?|wav|mp4|mov|webm|mpe?g|avi|ogv|flv|wmv)$ {
        expires    30d;
        include snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=2592000";
        access_log off;
        log_not_found off;
        # Pass to PHP to ensure PHP apps can handle routes that end in these filetypes
        try_files $uri @octane;
    }

    location ~* \.(?:svgz?|ttf|ttc|otf|eot|woff2?)$ {
        include snippets/security-headers.conf;
        add_header Access-Control-Allow-Origin "*";
        expires    7d;
        access_log off;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    include snippets/security-headers.conf;
}
