{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "#/objects/trip-summary",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[0-9a-zA-Z]{8,10}$"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": [
                "string",
                "null"
            ]
        },
        "entrance": {
            "anyOf": [
                {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer"
                        },
                        "name": {
                            "type": "string"
                        },
                        "slug": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "name",
                        "slug"
                    ]
                },
                {
                    "type": "null"
                }
            ]
        },
        "start_time": {
            "type": "string",
            "format": "date-time"
        },
        "end_time": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        },
        "participants": {
            "type": "array",
            "items": {
                "$ref": "user.json"
            }
        },
        "media": {
            "type": "array",
            "items": {
                "$ref": "media.json"
            }
        },
        "duration": {
            "type": [
                "integer",
                "number",
                "null"
            ]
        },
        "entrance_hero_image": {
            "type": [
                "string",
                "null"
            ]
        },
        "entrance_entrance_image": {
            "type": [
                "string",
                "null"
            ]
        }
    },
    "required": [
        "id",
        "name",
        "description",
        "start_time",
        "participants"
    ],
    "additionalProperties": false
}