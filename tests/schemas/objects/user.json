{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "#/objects/user",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "photo": {
      "type": [
        "string",
        "null"
      ]
    },
    "has_phone": {
      "type": "boolean"
    },
    "clubs": {
      "type": "array",
      "items": {
        "$ref": "club-summary.json"
      }
    }
  },
  "required": [
    "id",
    "name",
    "has_phone",
    "clubs"
  ],
  "additionalProperties": false
}