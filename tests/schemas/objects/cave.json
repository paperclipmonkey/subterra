{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "#/objects/cave",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "access_info": {
      "type": "string"
    },
    "hero_image": {
      "oneOf": [
        {
          "$ref": "cave-media.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "entrance_image": {
      "oneOf": [
        {
          "$ref": "cave-media.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "cave-media.json"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "tag.json"
      }
    },
    "caving_region": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_country": {
      "type": [
        "string",
        "null"
      ]
    },
    "location_lat": {
      "type": [
        "number",
        "null"
      ]
    },
    "location_lng": {
      "type": [
        "number",
        "null"
      ]
    },
    "location_alt": {
      "type": [
        "number",
        "null"
      ]
    },
    "system": {
      "$ref": "cave-system.json"
    },
    "trips": {
      "type": "array",
      "items": {
        "$ref": "trip.json"
      }
    },
    "previously_done": {
      "type": "boolean"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "caves_count": {
            "type": "integer"
          },
          "photo_path": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      }
    }
  },
  "required": [
    "id",
    "slug",
    "name",
    "description",
    "access_info",
    "tags",
    "caving_region",
    "system",
    "previously_done"
  ],
  "additionalProperties": false
}