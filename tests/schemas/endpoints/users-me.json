{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "definitions": {
    "user": {
      "$ref": "../objects/user.json"
    },
    "club-summary": {
      "$ref": "../objects/club-summary.json"
    }
  },
  "properties": {
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "photo": {
          "type": [
            "string",
            "null"
          ]
        },
        "bio": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "email_trophies": {
          "type": "boolean"
        },
        "email_tagged": {
          "type": "boolean"
        },
        "email_platform_news": {
          "type": "boolean"
        },
        "visibility_addable": {
          "type": "string",
          "enum": [
            "public",
            "club"
          ]
        },
        "clubs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "slug": {
                "type": "string",
                "minLength": 1
              },
              "is_admin": {
                "type": "boolean"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "slug",
              "is_admin",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "medals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "image_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "awarded_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "image_url",
              "awarded_at"
            ],
            "additionalProperties": false
          }
        },
        "is_admin": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_approved": {
          "type": "boolean"
        },
        "stats": {
          "type": "object",
          "properties": {
            "trips": {
              "type": "integer",
              "minimum": 0
            },
            "caves": {
              "type": "integer",
              "minimum": 0
            },
            "duration": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "trips",
            "caves",
            "duration"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "active_callout": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            },
            "cave": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            "participants": {
              "type": "array"
            }
          }
        },
        "tos_agreed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "privacy_policy_agreed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "clubs",
        "medals",
        "is_approved",
        "stats",
        "tos_agreed_at",
        "privacy_policy_agreed_at",
        "phone",
        "email_trophies",
        "email_tagged",
        "email_platform_news",
        "visibility_addable",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "data"
  ],
  "additionalProperties": false
}