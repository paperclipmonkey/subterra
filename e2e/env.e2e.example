# Environment for the Playwright system tests.
#
# Copy to the repo root as `.env.e2e` and run the app with APP_ENV=e2e, e.g.
#   php artisan serve --host=127.0.0.1 --port=8000
# Laravel loads `.env.<APP_ENV>` when it exists, and `artisan serve` forwards
# APP_ENV to its child PHP process (it is on ServeCommand::$passthroughVariables,
# which strips every other host variable — so DB_* set purely in the shell would
# silently be dropped and the app would fall back to `.env`).

APP_NAME=Subterra
APP_ENV=e2e
# Overwritten by `php artisan key:generate --env=e2e` in CI.
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=subterra_e2e
DB_USERNAME=subterra
DB_PASSWORD=password

# 127.0.0.1:8000 is already in Sanctum's default stateful list, but set it
# explicitly so a changed host/port fails loudly here rather than as a 401 in
# every authenticated spec.
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000
# Matches fly.toml. Note that .env.example still says `database`, but no
# sessions migration exists — that driver 500s on every request.
SESSION_DRIVER=cookie
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# The GCP watchdog is deliberately absent: CalloutService skips backup
# registration when it is unconfigured, which is the documented CI/local path.
# enforce_config must be off too, or callout creation refuses to run without
# real Twilio credentials.
GCP_WATCHDOG_URL=
CALLOUT_ENFORCE_CONFIG=false

ASSISTANT_STREAMING=false
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
