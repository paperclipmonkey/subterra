includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - app
    excludePaths:
        - app/Providers/BroadcastServiceProvider.php (?)
        - tests
    # Bootstrap Laravel for analysis
    bootstrapFiles:
        - bootstrap/app.php
    ignoreErrors:
        # Untyped User::clubs()/roles() relations, same as UserDetailEmailResource
        # (which is covered by the baseline).
        -
            identifiers:
                - property.notFound
                - argument.unresolvableType
            path: app/Http/Resources/AdminUserListResource.php
